{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "ChronoDesk",
  "version": "0.1.7",
  "identifier": "com.chronodesk.timer",
  "build": {
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build",
    "devUrl": "http://localhost:5173",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "ChronoDesk",
        "width": 1280,
        "height": 820,
        "minWidth": 1024,
        "minHeight": 680,
        "resizable": true,
        "decorations": true,
        "center": true,
        "skipTaskbar": false,
        "dragDropEnabled": false
      }
    ],
    "security": { "csp": "default-src 'self'; connect-src 'self' http://localhost:4000 https://*.tempo.app; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com; img-src 'self' data: blob:" }
  },
  "bundle": {
    "active": true,
    "targets": ["msi", "nsis"],
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "installerHooks": "installer-hooks.nsh"
      },
      "webviewInstallMode": { "type": "offlineInstaller" }
    },
    "createUpdaterArtifacts": true,
    "icon": [
      "icons/icon.ico",
      "icons/icon.png"
    ]
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEQ3OEE5NzU3ODcwNzQ4NDAKUldSQVNBZUhWNWVLMXhxYStNTDQzdVF5MVVXOVNpQ0ZDWHMvRWhYQzZ3c1V6MWVRT0dndXEzaCsK",
      "endpoints": [
        "https://github.com/slowly-ai/Time_Manager/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
