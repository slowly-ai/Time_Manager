{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "ChronoDesk",
  "version": "0.1.0",
  "identifier": "com.chronodesk.timer",
  "build": {
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build",
    "devUrl": "http://localhost:5173",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "ChronoDesk",
        "width": 1280,
        "height": 820,
        "minWidth": 1024,
        "minHeight": 680,
        "resizable": true,
        "decorations": true,
        "center": true,
        "dragDropEnabled": false
      }
    ],
    "security": { "csp": "default-src 'self'; connect-src 'self' http://localhost:4000 https://*.tempo.app; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com; img-src 'self' data: blob:" }
  },
  "bundle": {
    "active": true,
    "targets": ["msi", "nsis"],
    "windows": {
      "webviewInstallMode": { "type": "offlineInstaller" }
    }
  }
}
